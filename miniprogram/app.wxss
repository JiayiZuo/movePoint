page {
  min-height: 100%;
  background: #eef7ff;
  color: #102033;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

button {
  margin: 0;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  background: linear-gradient(180deg, #d7edff 0%, #eef7ff 360rpx, #f7fbff 360rpx, #f7fbff 100%);
}

.section {
  margin-bottom: 28rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #d7e7f5;
  border-radius: 14rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(45, 108, 166, 0.08);
}

.title {
  color: #102033;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.22;
}

.subtitle {
  margin-top: 8rpx;
  color: #5f7894;
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: #6f8399;
}

.button-primary,
.button-secondary,
.button-danger {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.button-primary {
  color: #ffffff;
  background: #2f8fe8;
}

.button-secondary {
  color: #2473ba;
  background: #e2f1ff;
}

.button-danger {
  color: #ffffff;
  background: #d84f5f;
}

.input,
.textarea,
.picker-box {
  min-height: 84rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 1rpx solid #cfe0ef;
  border-radius: 12rpx;
  background: #ffffff;
  color: #102033;
  font-size: 28rpx;
}

.textarea {
  min-height: 160rpx;
  width: 100%;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #263f58;
  font-size: 26rpx;
  font-weight: 700;
}

.empty {
  padding: 72rpx 24rpx;
  color: #6f8399;
  text-align: center;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e2f1ff;
  color: #2473ba;
  font-size: 24rpx;
  font-weight: 700;
}
