<view class="page">
  <view class="filters section">
    <picker mode="date" value="{{from}}" bindchange="onDate" data-field="from">
      <view class="filter">{{from}}</view>
    </picker>
    <picker mode="date" value="{{to}}" bindchange="onDate" data-field="to">
      <view class="filter">{{to}}</view>
    </picker>
  </view>

  <view class="summary section">
    <view class="panel summary-card">
      <text class="value">{{analysis.summary.total_sessions || 0}}</text>
      <text class="label-text">训练次数</text>
    </view>
    <view class="panel summary-card">
      <text class="value">{{durationHours}}</text>
      <text class="label-text">训练小时</text>
    </view>
    <view class="panel summary-card">
      <text class="value">{{calories}}</text>
      <text class="label-text">消耗千卡</text>
    </view>
    <view class="panel summary-card">
      <text class="value">{{analysis.summary.highest_grade || '-'}}</text>
      <text class="label-text">最高难度</text>
    </view>
  </view>

  <view class="panel section">
    <view class="section-title">难度分布</view>
    <view wx:if="{{gradeRows.length}}">
      <view class="bar-row" wx:for="{{gradeRows}}" wx:key="grade">
        <view class="bar-head">
          <text>{{item.grade}}</text>
          <text class="muted">{{item.success}} / {{item.attempts}}</text>
        </view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{item.rate}}%;"></view>
        </view>
      </view>
    </view>
    <view wx:else class="empty compact">暂无难度数据</view>
  </view>

  <view class="panel section">
    <view class="section-title">月度趋势</view>
    <view wx:if="{{monthlyRows.length}}">
      <view class="trend" wx:for="{{monthlyRows}}" wx:key="month">
        <text>{{item.month}}</text>
        <text>{{item.sessions}} 次 · {{item.duration}} 分钟</text>
      </view>
    </view>
    <view wx:else class="empty compact">暂无趋势数据</view>
  </view>
</view>
