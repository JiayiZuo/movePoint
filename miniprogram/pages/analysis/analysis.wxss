.filters {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.filter {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #d9dee5;
  text-align: center;
  font-size: 25rpx;
}

.summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.summary-card {
  min-height: 130rpx;
}

.value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.label-text {
  display: block;
  margin-top: 8rpx;
  color: #697586;
  font-size: 24rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.bar-row {
  margin-bottom: 24rpx;
}

.bar-head,
.trend {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.bar-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f6;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #1e6b58;
}

.trend {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.trend:last-child {
  border-bottom: 0;
}

.compact {
  padding: 28rpx 0;
}
