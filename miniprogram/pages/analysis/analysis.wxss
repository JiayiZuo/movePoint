.filters {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.filter {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #cfe0ef;
  color: #263f58;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
}

.summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-card {
  min-height: 130rpx;
  border-left: 8rpx solid #63b8ff;
}

.value {
  display: block;
  color: #102033;
  font-size: 42rpx;
  font-weight: 800;
}

.label-text {
  display: block;
  margin-top: 8rpx;
  color: #6f8399;
  font-size: 24rpx;
  font-weight: 700;
}

.section-title {
  margin-bottom: 24rpx;
  color: #102033;
  font-size: 32rpx;
  font-weight: 800;
}

.bar-row {
  margin-bottom: 24rpx;
}

.bar-head,
.trend {
  display: flex;
  justify-content: space-between;
  color: #263f58;
  font-size: 26rpx;
  font-weight: 700;
}

.bar-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2f1ff;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #2f8fe8;
}

.trend {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #d7e7f5;
}

.trend:last-child {
  border-bottom: 0;
}

.compact {
  padding: 28rpx 0;
}
