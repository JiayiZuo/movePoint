.records-page {
  padding-bottom: 44rpx;
}

.records-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.add-record-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 8rpx;
  width: 196rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #2f8fe8;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
}

.add-icon {
  font-size: 34rpx;
  line-height: 1;
}

.filter-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 108rpx;
  gap: 14rpx;
}

.filter,
.reset-filter {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #cfe0ef;
  color: #263f58;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
}

.reset-filter {
  padding: 0;
  color: #2473ba;
}

.record {
  margin-bottom: 18rpx;
  border-left: 8rpx solid #63b8ff;
}

.record-grade {
  color: #102033;
  font-size: 34rpx;
  font-weight: 800;
}

.meta {
  margin-top: 18rpx;
  color: #6f8399;
  font-size: 24rpx;
}

.success {
  background: #e2f1ff;
  color: #2473ba;
}

.failed {
  background: #ffe0e5;
  color: #b73748;
}

.empty-state {
  padding: 44rpx 32rpx;
  text-align: left;
}

.empty-title {
  color: #102033;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-copy {
  margin-top: 12rpx;
  color: #6f8399;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-action {
  margin-top: 28rpx;
}

.load-more {
  padding: 24rpx;
  color: #2473ba;
  text-align: center;
  font-weight: 800;
}
