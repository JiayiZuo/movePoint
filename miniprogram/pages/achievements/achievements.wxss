.achievements-page {
  padding-bottom: 40rpx;
}

.section-title {
  color: #102033;
  font-size: 32rpx;
  font-weight: 800;
}

.section-title-row {
  margin-bottom: 18rpx;
}

.link {
  color: #2473ba;
  font-size: 26rpx;
  font-weight: 800;
}

.achievement {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d7e7f5;
}

.achievement:last-child {
  border-bottom: 0;
}

.achievement-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
  background: #e2f1ff;
  color: #2473ba;
  text-align: center;
  font-size: 30rpx;
}

.achievement-body {
  flex: 1;
  min-width: 0;
}

.achievement-name {
  color: #102033;
  font-weight: 800;
  font-size: 28rpx;
}

.description {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.progress-text {
  color: #2473ba;
  font-size: 24rpx;
  font-weight: 800;
}

.progress {
  height: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2f1ff;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #2f8fe8;
}

.empty-state {
  padding: 48rpx 0 20rpx;
}

.empty-title {
  color: #102033;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-copy {
  margin-top: 12rpx;
  color: #6f8399;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-action {
  margin-top: 28rpx;
}
