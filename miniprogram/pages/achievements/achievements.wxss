/* pages/achievements/achievements.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.category-section {
  margin-bottom: 40rpx;
}

.category-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #4CAF50;
}

.achievement-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.achievement-item {
  width: 48%;
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  position: relative;
  transition: transform 0.3s ease;
}

.achievement-item:hover {
  transform: translateY(-4rpx);
}

.achievement-item.unlocked {
  border: 2rpx solid #4CAF50;
}

.achievement-item.locked {
  opacity: 0.7;
}

.achievement-icon {
  width: 80rpx;
  height: 80rpx;
  display: block;
  margin: 0 auto 20rpx;
}

.achievement-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 10rpx;
}

.achievement-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.achievement-progress {
  text-align: center;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background-color: #FFC107;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #FFC107;
  font-weight: bold;
}

.unlocked-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background-color: #4CAF50;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}