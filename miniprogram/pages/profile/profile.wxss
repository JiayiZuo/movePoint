.profile-page {
  padding-bottom: 40rpx;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #63b8ff 0%, #2f8fe8 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.3);
}

.profile-main {
  min-width: 0;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #ffffff;
}

.avatar-fallback {
  line-height: 112rpx;
  color: #2473ba;
  font-size: 42rpx;
  font-weight: 800;
  text-align: center;
}

.name {
  font-size: 36rpx;
  font-weight: 800;
}

.section-title {
  color: #102033;
  font-size: 32rpx;
  font-weight: 800;
}

.section-title-row {
  margin-bottom: 24rpx;
}

.two-col {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.link {
  color: #2473ba;
  font-size: 26rpx;
  font-weight: 800;
}

.profile-info {
  border-top: 1rpx solid #d7e7f5;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d7e7f5;
  font-size: 28rpx;
}

.info-label {
  color: #6f8399;
}

.info-value {
  color: #102033;
  font-weight: 800;
}

.bio-block {
  padding-top: 24rpx;
}

.bio-text {
  margin-top: 12rpx;
  color: #263f58;
  font-size: 28rpx;
  line-height: 1.6;
}

.edit-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left: 8rpx solid #63b8ff;
}

.menu-title {
  margin-bottom: 8rpx;
  color: #102033;
  font-size: 30rpx;
  font-weight: 800;
}

.menu-arrow {
  color: #2473ba;
  font-size: 48rpx;
  font-weight: 800;
}

.logout {
  margin-bottom: 40rpx;
}
