<!-- pages/profile/profile.wxml -->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-info-section" wx:if="{{profile}}">
    <view class="user-header">
      <image class="avatar" src="{{profile.avatar}}" />
      <view class="user-details">
        <text class="username">{{profile.nickName}}</text>
        <text class="level">Lv.{{profile.level}}</text>
      </view>
    </view>
    
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{stats.totalClimbs || 0}}</text>
        <text class="stat-label">总攀登次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.totalHours || 0}}</text>
        <text class="stat-label">总时长(h)</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.totalCalories || 0}}</text>
        <text class="stat-label">总卡路里</text>
      </view>
    </view>
  </view>

  <!-- 登录提示区域 -->
  <view class="login-prompt" wx:else>
    <image class="login-icon" src="/images/user-icon.png" />
    <text class="login-text">您还未登录，请先登录</text>
    <button class="login-btn" bindtap="goToLogin">立即登录</button>
  </view>

  <!-- 成就展示区域 -->
  <view class="achievements-section" wx:if="{{profile && achievements.length > 0}}">
    <view class="section-title">我的成就</view>
    <scroll-view scroll-x="true" class="achievements-scroll">
      <view class="achievement-list">
        <view class="achievement-item" wx:for="{{achievements}}" wx:key="index">
          <image class="achievement-icon" src="{{item.icon}}" />
          <text class="achievement-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 功能列表 -->
  <view class="function-list">
    <view class="function-item" bindtap="updateProfile">
      <text class="function-text">编辑资料</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item" bindtap="goToAchievements">
      <text class="function-text">我的成就</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item">
      <text class="function-text">设置</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>