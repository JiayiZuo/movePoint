<view class="page">
  <view class="panel profile-head section">
    <image wx:if="{{profile.avatar_url}}" class="avatar" src="{{profile.avatar_url}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-fallback">{{avatarLetter}}</view>
    <view>
      <view class="name">{{profile.username || user.username}}</view>
      <view class="muted">{{profile.email || user.email}}</view>
    </view>
  </view>

  <view class="panel section">
    <view class="section-title">个人资料</view>
    <view class="field">
      <text class="label">头像 URL</text>
      <input class="input" value="{{form.avatar_url}}" bindinput="onInput" data-field="avatar_url" />
    </view>
    <view class="field two-col">
      <view>
        <text class="label">体重 kg</text>
        <input class="input" type="digit" value="{{form.weight}}" bindinput="onInput" data-field="weight" />
      </view>
      <view>
        <text class="label">身高 cm</text>
        <input class="input" type="digit" value="{{form.height}}" bindinput="onInput" data-field="height" />
      </view>
    </view>
    <view class="field">
      <text class="label">生日</text>
      <picker mode="date" value="{{form.birth_date}}" bindchange="onBirthDate">
        <view class="picker-box">{{form.birth_date || '选择生日'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">简介</text>
      <textarea class="textarea" value="{{form.bio}}" bindinput="onInput" data-field="bio" />
    </view>
    <button class="button-primary" loading="{{saving}}" bindtap="saveProfile">保存资料</button>
  </view>

  <view class="panel section">
    <view class="row between section-title-row">
      <view class="section-title">成就</view>
      <view class="link" bindtap="checkAchievements">刷新</view>
    </view>
    <view wx:if="{{achievements.length}}">
      <view class="achievement" wx:for="{{achievements}}" wx:key="id">
        <view class="achievement-icon">{{item.icon || '★'}}</view>
        <view class="achievement-body">
          <view class="row between">
            <text class="achievement-name">{{item.name}}</text>
            <text class="muted">{{item.progress}}%</text>
          </view>
          <view class="muted">{{item.description}}</view>
          <view class="progress"><view class="progress-fill" style="width: {{item.progress}}%;"></view></view>
        </view>
      </view>
    </view>
    <view wx:else class="empty compact">暂无成就，刷新后会初始化。</view>
  </view>

  <button class="button-secondary logout" bindtap="logout">退出登录</button>
</view>
