<view class="page auth-page">
  <view class="brand">
    <view class="title">MovePoint</view>
    <view class="subtitle">记录每一次攀爬，也看见自己的进步。</view>
  </view>

  <view class="panel">
    <view class="field">
      <text class="label">邮箱</text>
      <input class="input" type="text" placeholder="name@example.com" value="{{email}}" bindinput="onInput" data-field="email" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="至少 6 位" value="{{password}}" bindinput="onInput" data-field="password" />
    </view>
    <button class="button-primary" loading="{{loading}}" bindtap="submit">登录</button>
    <button class="button-secondary register-link" bindtap="goRegister">创建新账号</button>
  </view>
</view>
