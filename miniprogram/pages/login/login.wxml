<!-- pages/login/login.wxml -->
<view class="container">
  <view class="login-form">
    <view class="title">欢迎使用</view>
    <view class="subtitle">请登录以继续</view>
    
    <!-- 微信登录按钮 -->
    <button class="wechat-login-btn" open-type="getUserInfo" bindgetuserinfo="onWechatLogin">
      <view class="wechat-login-content">
        <image src="/images/wechat-icon.png" class="wechat-icon"></image>
        <text class="wechat-login-text">微信一键登录</text>
      </view>
    </button>
    
    <!-- 其他登录选项 -->
    <view class="other-options">
      <text class="option-text">其他登录方式</text>
      <view class="divider"></view>
    </view>
    
    <!-- 注册链接 -->
    <view class="register-link">
      <text>还没有账号？</text>
      <text class="link" bindtap="navigateToRegister">立即注册</text>
    </view>
  </view>
</view>