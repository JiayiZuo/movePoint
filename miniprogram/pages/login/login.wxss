/* pages/login/login.wxss */
.container {
  padding: 100rpx 60rpx 0;
  background-color: #fff;
  min-height: 100vh;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 80rpx;
  color: #333;
}

.input-group {
  margin-bottom: 40rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.login-btn {
  width: 100%;
  height: 80rpx;
  background-color: #1aad19;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}

.register-link {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #999;
}

.link {
  color: #1aad19;
  margin-left: 10rpx;
}