/* pages/login/login.wxss */
.container {
  padding: 100rpx 60rpx 0;
  background-color: #fff;
  min-height: 100vh;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: #333;
}

.subtitle {
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 80rpx;
  color: #999;
}

.wechat-login-btn {
  width: 100%;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.wechat-login-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.wechat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.wechat-login-text {
  font-size: 32rpx;
  color: #fff;
}

.other-options {
  display: flex;
  align-items: center;
  margin: 60rpx 0;
}

.divider {
  flex: 1;
  height: 1rpx;
  background-color: #e5e5e5;
  margin: 0 20rpx;
}

.option-text {
  font-size: 24rpx;
  color: #999;
}

.register-link {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #999;
}

.link {
  color: #1aad19;
  margin-left: 10rpx;
}