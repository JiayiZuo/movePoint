<view class="page dashboard-page">
  <view class="section hero">
    <view>
      <view class="subtitle">欢迎回来</view>
      <view class="title">{{profile.username || user.username || '攀岩者'}}</view>
    </view>
    <button class="add-record-button" bindtap="addRecord">
      <text class="add-icon">+</text>
      <text>添加记录</text>
    </button>
  </view>

  <view class="training-card section">
    <view class="training-content">
      <view class="training-kicker">QUICK LOG</view>
      <view class="training-title">今天爬了吗？</view>
      <view class="training-copy">快速记一次训练，之后再慢慢补细节。</view>
    </view>
    <view class="quick-actions">
      <button class="quick-action primary" bindtap="quickAdd" data-type="bouldering">抱石</button>
      <button class="quick-action" bindtap="quickAdd" data-type="sport_climbing">难度</button>
    </view>
  </view>

  <view class="stats-grid section">
    <view class="stat">
      <text class="stat-value">{{stats.total_sessions || 0}}</text>
      <text class="stat-label">总次数</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{durationHours}}</text>
      <text class="stat-label">总小时</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{stats.highest_grade || '-'}}</text>
      <text class="stat-label">最高难度</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{stats.weekly_sessions || 0}}</text>
      <text class="stat-label">本周</text>
    </view>
  </view>

  <view class="section row between">
    <view class="section-title">最近记录</view>
    <view class="link" bindtap="goRecords">全部</view>
  </view>

  <view wx:if="{{records.length}}">
    <view class="record panel" wx:for="{{records}}" wx:key="id" bindtap="openRecord" data-id="{{item.id}}">
      <view class="row between">
        <view>
          <view class="record-grade">{{item.grade || '未填写难度'}}</view>
          <view class="muted">{{item.location || '未填写地点'}}</view>
        </view>
        <view class="chip">{{item.typeText}}</view>
      </view>
      <view class="record-meta">{{item.startText}} · {{item.durationText}}</view>
    </view>
  </view>
  <view wx:else class="panel empty-state">
    <view class="empty-title">还没有训练记录</view>
    <view class="empty-copy">从一次抱石或一次难度训练开始，慢慢就能看到自己的路线、强度和进步。</view>
    <button class="button-primary empty-action" bindtap="addRecord">添加第一条记录</button>
  </view>
</view>
