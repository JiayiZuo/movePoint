.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
}

.quick-add {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  border-radius: 50%;
  background: #1e6b58;
  color: #ffffff;
  font-size: 48rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stat {
  min-height: 146rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e7eaee;
}

.stat-value {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  color: #697586;
  font-size: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.link {
  color: #1e6b58;
  font-size: 26rpx;
}

.record {
  margin-bottom: 18rpx;
}

.record-grade {
  font-size: 34rpx;
  font-weight: 700;
}

.record-meta {
  margin-top: 20rpx;
  color: #697586;
  font-size: 24rpx;
}
