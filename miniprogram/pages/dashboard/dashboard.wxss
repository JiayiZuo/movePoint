.dashboard-page {
  padding-bottom: 48rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 20rpx;
}

.add-record-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 8rpx;
  width: 196rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #2f8fe8;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 26rpx rgba(47, 143, 232, 0.24);
}

.add-icon {
  font-size: 34rpx;
  line-height: 1;
}

.training-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 34rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #63b8ff 0%, #2f8fe8 52%, #1d5f9f 100%);
  color: #ffffff;
  box-shadow: 0 24rpx 50rpx rgba(47, 143, 232, 0.24);
}

.training-card::before {
  content: "";
  position: absolute;
  top: -86rpx;
  right: -76rpx;
  width: 260rpx;
  height: 260rpx;
  border: 24rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
}

.training-content {
  position: relative;
  min-width: 0;
}

.training-kicker {
  display: inline-flex;
  margin-bottom: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #eaf6ff;
  font-size: 22rpx;
  font-weight: 800;
}

.training-title {
  font-size: 40rpx;
  font-weight: 800;
}

.training-copy {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.quick-actions {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  width: 100%;
}

.quick-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.quick-action.primary {
  background: #ffffff;
  color: #2473ba;
  border-color: #ffffff;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stat {
  min-height: 148rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border-left: 8rpx solid #63b8ff;
  box-shadow: 0 16rpx 34rpx rgba(45, 108, 166, 0.08);
}

.stat-value {
  display: block;
  color: #102033;
  font-size: 44rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 8rpx;
  color: #6f8399;
  font-size: 24rpx;
  font-weight: 700;
}

.section-title {
  color: #102033;
  font-size: 32rpx;
  font-weight: 800;
}

.link {
  color: #2473ba;
  font-size: 26rpx;
  font-weight: 800;
}

.record {
  margin-bottom: 18rpx;
}

.record-grade {
  color: #102033;
  font-size: 34rpx;
  font-weight: 800;
}

.record-meta {
  margin-top: 20rpx;
  color: #6f8399;
  font-size: 24rpx;
}

.empty-state {
  padding: 44rpx 32rpx;
  text-align: left;
}

.empty-title {
  color: #102033;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-copy {
  margin-top: 12rpx;
  color: #6f8399;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-action {
  margin-top: 28rpx;
}
