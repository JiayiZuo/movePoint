/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f0f8ff;
  min-height: 100vh;
  background-image: linear-gradient(135deg, #f0f8ff 0%, #e6f3ff 100%);
}

.header-section {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(30, 60, 114, 0.2);
  color: white;
}

.greeting {
  margin-bottom: 30rpx;
}

.greeting-text {
  display: block;
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
}

.achievement-stats {
  display: flex;
  justify-content: space-between;
}

.stat-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  padding: 25rpx;
  border-radius: 16rpx;
  text-align: center;
  flex: 1;
  margin: 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.stat-card.climbing {
  background: rgba(46, 204, 113, 0.2);
}

.stat-card.duration {
  background: rgba(52, 152, 219, 0.2);
}

.stat-card.calories {
  background: rgba(231, 76, 60, 0.2);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.quick-actions-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  height: 100rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  position: relative;
}

.action-btn.primary {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  color: white;
}

.action-btn.secondary {
  background: #f8f9fa;
  color: #1e3c72;
  border: 1rpx solid #e9ecef;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
}

.recent-activities-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.view-all {
  font-size: 26rpx;
  color: #1e3c72;
  font-weight: normal;
}

.recent-activities {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
}

.activity-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e9ecef;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-info {
  display: flex;
  flex-direction: column;
}

.activity-grade {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.activity-type {
  font-size: 24rpx;
  color: #7f8c8d;
}

.activity-time {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.activity-duration {
  font-size: 26rpx;
  color: #27ae60;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.activity-date {
  font-size: 22rpx;
  color: #95a5a6;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #95a5a6;
}