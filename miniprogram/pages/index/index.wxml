<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 头部区域 -->
  <view class="header-section">
    <view class="greeting">
      <text class="greeting-text">欢迎回来</text>
      <text class="user-name">{{userInfo.nickName || '攀岩者'}}</text>
    </view>
    
    <!-- 攀岩成就统计 -->
    <view class="achievement-stats">
      <view class="stat-card climbing">
        <text class="stat-value">{{dailyStats.sessions}}</text>
        <text class="stat-label">本周攀岩</text>
      </view>
      <view class="stat-card duration">
        <text class="stat-value">{{dailyStats.duration}}h</text>
        <text class="stat-label">累计时长</text>
      </view>
      <view class="stat-card calories">
        <text class="stat-value">{{dailyStats.calories}}</text>
        <text class="stat-label">卡路里</text>
      </view>
    </view>
  </view>

  <!-- 快捷操作区域 -->
  <view class="quick-actions-section">
    <text class="section-title">快速操作</text>
    <view class="quick-actions">
      <button class="action-btn primary" bindtap="navigateToAddRecord">
        <image src="/images/add-icon.png" class="action-icon"></image>
        <text>添加记录</text>
      </button>
      <button class="action-btn secondary" bindtap="navigateToAnalysis">
        <image src="/images/chart-icon.png" class="action-icon"></image>
        <text>数据分析</text>
      </button>
      <button class="action-btn secondary" bindtap="navigateToRecords">
        <image src="/images/list-icon.png" class="action-icon"></image>
        <text>全部记录</text>
      </button>
    </view>
  </view>

  <!-- 最近活动区域 -->
  <view class="recent-activities-section">
    <view class="section-header">
      <text class="section-title">最近活动</text>
      <text class="view-all" bindtap="navigateToRecords">查看全部</text>
    </view>
    
    <view class="recent-activities">
      <view class="activity-item" wx:for="{{recentRecords}}" wx:key="id">
        <view class="activity-info">
          <text class="activity-grade">{{item.grade}}</text>
          <text class="activity-type">{{item.type}}</text>
        </view>
        <view class="activity-time">
          <text class="activity-duration">{{item.duration}}分钟</text>
          <text class="activity-date">{{item.date}}</text>
        </view>
      </view>
      
      <view wx:if="{{recentRecords.length === 0}}" class="empty-state">
        <image src="/images/empty-icon.png" class="empty-icon"></image>
        <text class="empty-text">暂无记录，快去挑战新路线吧！</text>
      </view>
    </view>
  </view>
</view>