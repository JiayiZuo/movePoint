<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="userinfo">
    <button wx:if="{{!hasUserInfo && canIUseGetUserProfile}}" bindtap="getUserProfile" class="userinfo-nickname">
      点击登录
    </button>
    <block wx:else>
      <image src="{{userInfo.avatarUrl}}" class="userinfo-avatar" mode="cover"></image>
      <text class="userinfo-nickname">{{userInfo.nickName}}</text>
    </block>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-container">
    <view class="stat-card">
      <text class="stat-value">{{dailyStats.sessions}}</text>
      <text class="stat-label">本周攀岩次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{dailyStats.duration}}h</text>
      <text class="stat-label">累计时长</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{dailyStats.calories}}</text>
      <text class="stat-label">卡路里</text>
    </view>
  </view>

  <!-- 快捷操作按钮 -->
  <view class="quick-actions">
    <button class="action-btn primary" bindtap="navigateToAddRecord">添加记录</button>
    <button class="action-btn secondary" bindtap="navigateToAnalysis">查看分析</button>
    <button class="action-btn secondary" bindtap="navigateToRecords">全部记录</button>
  </view>

  <!-- 最近记录 -->
  <view class="recent-records">
    <text class="section-title">最近活动</text>
    <view class="record-item" wx:for="{{recentRecords}}" wx:key="id">
      <text>{{item.grade}} {{item.type}}</text>
      <text>{{item.duration}}分钟</text>
    </view>
    <view wx:if="{{recentRecords.length === 0}}" class="empty-tips">
      暂无记录，快去添加第一条攀岩记录吧！
    </view>
  </view>
</view>